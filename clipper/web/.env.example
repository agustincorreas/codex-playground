# Supabase (mismo proyecto que el worker)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
STORAGE_BUCKET=clipper

# Contraseña única para entrar a la app (si se deja vacía, no pide contraseña)
APP_PASSWORD=
# Cualquier string largo y aleatorio; firma la cookie de sesión
APP_SECRET=cambiame-por-algo-largo-y-aleatorio

# URL pública de la app (para el callback de Google)
APP_URL=http://localhost:3000

# Google OAuth (Drive). Mismo cliente que el worker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Picker (visible en el navegador)
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
