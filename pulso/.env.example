# Copiá este archivo como ".env" (en esta misma carpeta) y completá lo que uses.
# Sin claves, Pulso arranca en modo demo con el mercado simulado.

# Proveedor: auto (elige según las claves), alpaca, massive o demo.
DATA_PROVIDER=auto

# ---- Alpaca (https://alpaca.markets) -------------------------------------------------
# Cuenta gratis (plan Basic): feed "iex" = modo en capas: precio en tiempo real de la bolsa IEX
# y, por detrás, el mercado completo con 15 minutos de demora (volumen, máximos y escáneres).
# Algo Trader Plus (US$ 99/mes): feed "sip" (todas las bolsas en tiempo real). Ver README.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
# Cuántos símbolos "calientes" reciben prints tick a tick (con iex el máximo es 30).
# ALPACA_HOT_SYMBOLS=400
# Plan gratis: cada cuántos segundos se repasa el mercado completo demorado (todo el universo) y
# cada cuántos se completan las velas consolidadas de los símbolos calientes.
# ALPACA_DELAYED_POLL_SEC=60
# ALPACA_HOT_REFRESH_SEC=300

# ---- Massive, ex Polygon.io (https://massive.com) ------------------------------------
# Plan: basic (gratis: solo float y short interest), starter / developer (15 min de demora)
# o advanced (tiempo real, US$ 199/mes). La clave gratis sirve para el float aunque uses Alpaca.
MASSIVE_API_KEY=
MASSIVE_PLAN=basic

# ---- Extras gratuitos ------------------------------------------------------------------
# SEC EDGAR exige identificarse: "Nombre Apellido tu@email.com". Activa las etiquetas de
# dilución (S-1, S-3, 424B, 8-K 3.02) y las acciones en circulación.
SEC_USER_AGENT=
# Halts del RSS de Nasdaq (true por defecto).
# HALTS_RSS=true
# Float alternativo: Financial Modeling Prep (plan Starter en adelante).
# FMP_API_KEY=
# CSV propio con columnas SIMBOLO,float[,acciones_en_circulacion] (tiene prioridad).
# FLOAT_CSV=./data/float.csv

# ---- Servidor ----------------------------------------------------------------------------
PORT=8787
# 127.0.0.1 = solo esta computadora. 0.0.0.0 = también el celular en tu misma red Wi-Fi.
HOST=127.0.0.1
# Rango de precio (cierre anterior) de las acciones que se siguen.
# UNIVERSE_MIN_PRICE=0.2
# UNIVERSE_MAX_PRICE=60
